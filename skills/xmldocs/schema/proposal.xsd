<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proposal: a change not yet made. States the problem, what exists today,
  the proposed solution and the decisions it needs.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:include schemaLocation="base.xsd"/>

  <xs:element name="proposal">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="problem" type="blockContent"/>
        <xs:element name="current" type="blockContent" minOccurs="0"/>
        <xs:element name="solution" type="blockContent"/>
        <xs:element name="decisions" minOccurs="0">
          <xs:complexType><xs:sequence><xs:element ref="decision" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
        </xs:element>
        <xs:element name="consequences" type="blockContent" minOccurs="0"/>
        <xs:element ref="related" minOccurs="0"/>
      </xs:sequence>
      <xs:attributeGroup ref="docAttributes"/>
      <xs:attribute name="status" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:token">
            <xs:enumeration value="draft"/>
            <xs:enumeration value="review"/>
            <xs:enumeration value="accepted"/>
            <xs:enumeration value="rejected"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
</xs:schema>
